{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tareq-alomari/ibb-business-database/schemas/institute-record.schema.json",
  "title": "Ibb Institute Record",
  "description": "Schema for a technical, vocational, language or other institute-level organisation in Ibb Governorate.",
  "type": "object",
  "required": ["record_id", "name", "governorate", "institution_type", "verification_status", "confidence", "sources", "updated_at"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^ibb-institute-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "governorate": { "const": "Ibb" },
    "institution_type": { "type": "string", "enum": ["technical_institute", "vocational_institute", "health_institute", "language_institute", "training_institute", "unknown"] },
    "ownership_status": { "type": "string", "enum": ["government_verified", "private_verified", "unknown"] },
    "official_url": { "type": ["string", "null"], "format": "uri" },
    "verification_status": { "type": "string", "enum": ["official_verified", "field_verified", "public_candidate", "stale", "rejected"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "sources": { "type": "array", "minItems": 1 },
    "updated_at": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
