{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tareq-alomari/ibb-business-database/schemas/school-record.schema.json",
  "title": "Ibb School Record",
  "description": "Schema for a school candidate or verified record in Ibb Governorate. It separates institution type from ownership verification.",
  "type": "object",
  "required": ["record_id", "name", "governorate", "institution_type", "ownership_status", "verification_status", "confidence", "sources", "updated_at"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^ibb-school-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "name_ar": { "type": ["string", "null"] },
    "name_en": { "type": ["string", "null"] },
    "governorate": { "const": "Ibb" },
    "district": { "type": ["string", "null"] },
    "institution_type": { "type": "string", "enum": ["school", "kindergarten", "college", "university", "other"] },
    "ownership_status": { "type": "string", "enum": ["government_verified", "private_verified", "government_candidate", "private_candidate", "unknown"] },
    "geometry": { "type": ["object", "null"], "description": "GeoJSON geometry; a candidate location requires official or field confirmation." },
    "education_stages": { "type": "array", "items": { "type": "string" }, "default": [] },
    "verification_status": { "type": "string", "enum": ["official_verified", "field_verified", "public_candidate", "stale", "rejected"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_url", "retrieved_at", "license"],
        "properties": {
          "source_id": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" },
          "retrieved_at": { "type": "string", "format": "date" },
          "verified_at": { "type": ["string", "null"], "format": "date" },
          "license": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "updated_at": { "type": "string", "format": "date" },
    "change_note": { "type": "string" }
  },
  "additionalProperties": false
}
