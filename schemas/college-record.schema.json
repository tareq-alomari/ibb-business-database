{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tareq-alomari/ibb-business-database/schemas/college-record.schema.json",
  "title": "Ibb College Unit Record",
  "description": "Schema for an officially sourced college or college-level academic unit in Ibb Governorate.",
  "type": "object",
  "required": ["record_id", "name", "parent_institution", "governorate", "verification_status", "confidence", "sources", "updated_at"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^ibb-college-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "parent_institution": { "type": "string", "minLength": 1 },
    "governorate": { "const": "Ibb" },
    "unit_type": { "type": "string", "enum": ["college", "college_branch", "academic_unit"] },
    "official_url": { "type": ["string", "null"], "format": "uri" },
    "verification_status": { "type": "string", "enum": ["official_verified", "field_verified", "public_candidate", "stale", "rejected"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "sources": { "type": "array", "minItems": 1 },
    "updated_at": { "type": "string", "format": "date" },
    "change_note": { "type": "string" }
  },
  "additionalProperties": false
}
